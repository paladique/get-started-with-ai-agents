# Storefront browsing and the demo cart work without Azure credentials.
# Enable only if you want to use the legacy agent API endpoints.
ENABLE_AI_AGENT=false

# Required only when ENABLE_AI_AGENT=true: copy your Microsoft Foundry project endpoint (not an OpenAI endpoint).
AZURE_EXISTING_AIPROJECT_ENDPOINT=
# Required for agent-enabled Uvicorn: an existing prompt agent version, e.g. demo-assistant:1.
AZURE_EXISTING_AGENT_ID=
# Required only when ENABLE_AI_AGENT=true: deployed model name, which may differ from the underlying model ID.
AZURE_AI_AGENT_DEPLOYMENT_NAME=
# Agent name used only when initializing/creating an agent with gunicorn.conf.py.
AZURE_AI_AGENT_NAME=demo-assistant
# Optional: full project ARM resource ID, used for the Foundry portal link.
AZURE_EXISTING_AIPROJECT_RESOURCE_ID=

# Authentication: run `az login` locally. No OpenAI API key is required.
# Alternatively uncomment ALL THREE for service principal authentication:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Optional HTTP Basic auth: set both to enable, leave both empty to disable.
WEB_APP_USERNAME=
WEB_APP_PASSWORD=

ENABLE_AZURE_MONITOR_TRACING=false
# Required when enabling Foundry GenAI tracing:
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=false
APP_LOG_FILE=

# Optional Azure AI Search setup; disabled uses OpenAI File Search on creation.
USE_AZURE_AI_SEARCH_SERVICE=false
# AZURE_AI_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# SEARCH_CONNECTION_ID=<Foundry project search connection ID>
# AZURE_AI_SEARCH_INDEX_NAME=index-sample
# AZURE_AI_EMBED_DEPLOYMENT_NAME=<embedding deployment name>
# AZURE_AI_EMBED_DIMENSIONS=1536
# AZURE_BLOB_CONTAINER_NAME=documents
# STORAGE_ACCOUNT_RESOURCE_ID=/subscriptions/<id>/resourceGroups/<group>/providers/Microsoft.Storage/storageAccounts/<name>
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Ignite presentation demo: replay is always available without cloud calls.
# Live mode uses the existing Foundry project endpoint and model deployment above.
# It does not require a registered agent version or ENABLE_AI_AGENT=true.
ENABLE_LIVE_DEMO=false
# Export genuine OTel spans only when explicitly enabled and a collector is ready.
DEMO_EXPORT_TRACES=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Datadog Agent Observability: direct OTLP/HTTP; no local Datadog Agent required.
# Marketplace Azure integration alone does not instrument this application's agent.
# Set only on the backend, never as VITE_* variables.
DD_LLMOBS_ENABLED=false
DD_LLMOBS_AGENTLESS_ENABLED=true
DD_SITE=us3.datadoghq.com
DD_API_KEY=
DD_LLMOBS_ML_APP=fieldwork-ignite-demo
DD_SERVICE=fieldwork-ignite-demo
DD_ENV=presentation
DD_VERSION=ignite-2026
DD_LLMOBS_EVALUATIONS_ENABLED=true
